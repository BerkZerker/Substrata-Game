[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/gui/debug/controls_overlay.gd" id="1_script"]
[ext_resource type="Theme" path="res://assets/theme/hud_theme.tres" id="2_theme"]

[node name="ControlsOverlay" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -160.0
offset_right = 180.0
offset_bottom = 160.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")
visible = false

[node name="Label" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "=== Controls ===

Movement
  A / D ........... Move Left / Right
  Space ........... Jump
  Scroll .......... Zoom
  Z ............... Cycle Zoom Presets

Editing
  LMB Hold ........ Destroy Terrain (force)
  RMB Hold ........ Place Terrain (circle)
  1-9 ............. Select Material
  Q / E ........... Brush Value -/+

Debug & UI
  F1 .............. This Help
  F2 .............. Cursor Info
  F3 .............. Debug HUD
  F4 .............. World Overlay"
